{
  "manifest_version": 3,
  "name": "Former",
  "version": "1.1.3",
  "description": "Former vas štiti od slučajnog otvaranja Informera.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Former — Zaštita od Informera"
  },
  "permissions": [
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.informer.rs/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "chrome-background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "web_accessible_resources": [
  {
    "resources": [
      "blocked.html"
    ],
    "matches": [
      "<all_urls>"
    ]
  }
],

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube-guard.js"
      ],
      "run_at": "document_start"
    }
  ]
}
