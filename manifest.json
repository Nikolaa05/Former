{
  "manifest_version": 3,
  "name": "Former",
  "version": "1.1.3",
  "description": "Former vas štiti od slučajnog otvaranja Informera.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Former — Zaštita od Informera"
  },
  "permissions": [
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.informer.rs/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js",
      "social-blocker.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{ffbfba55-ce27-4149-8b00-db695a26136e}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "*://*.informer.rs/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube-guard.js"
      ],
      "run_at": "document_start"
    }
  ]
}
